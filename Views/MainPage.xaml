<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:Beacon.ViewModels"
             xmlns:models="clr-namespace:Beacon.Models"
             x:Class="Beacon.MainPage"
             x:DataType="viewmodels:MainViewModel">

    <ContentPage.Resources>
        <Style x:Key="MainActionButton" TargetType="Button">
            <Setter Property="HeightRequest" Value="200" />
            <Setter Property="WidthRequest" Value="200" />
            <Setter Property="CornerRadius" Value="100" />
            <Setter Property="FontSize" Value="18" />
            <Setter Property="Margin" Value="20" />
        </Style>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,*,Auto"
          Padding="20">

        <!-- Header Section -->
        <Grid Grid.Row="0" 
              ColumnDefinitions="*,Auto"
              Margin="0,0,0,20">
            <StackLayout Grid.Column="0">
                <Label Text="Beacon"
                       FontSize="24"
                       FontAttributes="Bold" />
                <Label Text="Never get lost again"
                       FontSize="16"
                       Opacity="0.7" />
            </StackLayout>

            <!-- GPS Status Indicator -->
            <Frame Grid.Column="1"
                   HeightRequest="44"
                   WidthRequest="44"
                   CornerRadius="22"
                   Padding="0"
                   IsClippedToBounds="True">
                <Grid>
                    <Ellipse Fill="{Binding SignalStatus, Converter={StaticResource SignalStatusToColorConverter}}"
                            HeightRequest="12"
                            WidthRequest="12"
                            HorizontalOptions="Center"
                            VerticalOptions="Center" />
                </Grid>
            </Frame>
        </Grid>

        <!-- Main Content Area -->
        <Grid Grid.Row="1">
            <!-- Set Beacon State -->
            <StackLayout IsVisible="{Binding CurrentState, Converter={StaticResource StateToVisibilityConverter}, ConverterParameter={x:Static models:AppState.SetBeacon}}"
                         HorizontalOptions="Center"
                         VerticalOptions="Center">
                <Button Text="Set Beacon"
                        Style="{StaticResource MainActionButton}"
                        Command="{Binding SetBeaconCommand}"
                        IsEnabled="{Binding SignalStatus, Converter={StaticResource SignalStatusToEnabledConverter}}" />
            </StackLayout>

            <!-- Find Beacon State -->
            <StackLayout IsVisible="{Binding CurrentState, Converter={StaticResource StateToVisibilityConverter}, ConverterParameter={x:Static models:AppState.FindBeacon}}"
                         HorizontalOptions="Center"
                         VerticalOptions="Center">
                <Button Text="Find Beacon"
                        Style="{StaticResource MainActionButton}"
                        Command="{Binding StartNavigationCommand}" />
            </StackLayout>

            <!-- Navigation State -->
            <Grid IsVisible="{Binding CurrentState, Converter={StaticResource StateToVisibilityConverter}, ConverterParameter={x:Static models:AppState.Navigation}}"
                  RowDefinitions="*,Auto">
                <Grid>
                    <!-- Direction arrow -->
                    <Image Source="nav_arrow.png"
                           Rotation="{Binding ArrowRotation}"
                           Scale="1.0"
                           HeightRequest="300"
                           WidthRequest="300"
                           HorizontalOptions="Center"
                           VerticalOptions="Center"
                           Aspect="AspectFit" />
                </Grid>
                
                <Label Grid.Row="1"
                       Text="{Binding Distance, StringFormat='{0:F0} meters away'}"
                       FontSize="24"
                       HorizontalOptions="Center"
                       />
                <Button Grid.Row="2"
                        Text="Stop Navigation"
                        Command="{Binding StopNavigationCommand}"
                        Margin="0,80,0,0" />
            </Grid>

            <!-- Destination State -->
            <StackLayout IsVisible="{Binding CurrentState, Converter={StaticResource StateToVisibilityConverter}, ConverterParameter={x:Static models:AppState.Destination}}"
                         HorizontalOptions="Center"
                         VerticalOptions="Center">
                <Label Text="You made it!"
                       FontSize="32"
                       HorizontalOptions="Center" />
                <Button Text="Complete Journey"
                        Command="{Binding CompleteJourneyCommand}"
                        Margin="0,20,0,0" />
            </StackLayout>
        </Grid>

        <!-- Status Banner -->
        <Frame Grid.Row="2"
               BorderColor="Transparent"
               BackgroundColor="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray600}}"
               Margin="0,20,0,0"
               Padding="10">
            <Grid ColumnDefinitions="*,Auto">
                <Label Grid.Column="0" 
                       Text="{Binding StatusMessage}"
                       VerticalOptions="Center"
                       HorizontalOptions="Center"/>
                <Button Grid.Column="1"
                        Text="×"
                        FontSize="20"
                        Command="{Binding ClearBeaconCommand}"
                        IsVisible="{Binding CurrentState, Converter={StaticResource StateToVisibilityConverter}, ConverterParameter={x:Static models:AppState.FindBeacon}}"
                        BackgroundColor="Transparent" />
            </Grid>
        </Frame>
    </Grid>
</ContentPage>