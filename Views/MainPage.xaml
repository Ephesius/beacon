<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:Beacon.ViewModels"
             xmlns:models="clr-namespace:Beacon.Models"
             x:Class="Beacon.MainPage"
             x:DataType="viewmodels:MainViewModel">

    <ContentPage.Resources>
        <Style x:Key="MainActionButton" TargetType="Button">
            <Setter Property="HeightRequest" Value="200" />
            <Setter Property="WidthRequest" Value="200" />
            <Setter Property="CornerRadius" Value="100" />
            <Setter Property="FontSize" Value="18" />
            <Setter Property="Margin" Value="20" />
        </Style>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,*,Auto,Auto"
          Padding="0,10,0,0">

        <!-- Header Section -->
        <Grid Grid.Row="0" 
              ColumnDefinitions="*"
              Margin="0,0,0,20">
            <StackLayout Grid.Column="0">
                <Label Text="Beacon"
                       FontSize="24"
                       FontAttributes="Bold"
                       HorizontalOptions="Center"/>
                <Label Text="Never get lost again"
                       FontSize="16"
                       Opacity="0.7"
                       HorizontalOptions="Center"/>
            </StackLayout>
        </Grid>

        <!-- Main Content Area -->
        <Grid Grid.Row="1">
            <!-- Set Beacon State -->
            <StackLayout IsVisible="{Binding CurrentState, Converter={StaticResource StateToVisibilityConverter}, ConverterParameter={x:Static models:AppState.SetBeacon}}"
                         HorizontalOptions="Center"
                         VerticalOptions="Center">
                <Button Text="Set Beacon"
                        Style="{StaticResource MainActionButton}"
                        Command="{Binding SetBeaconCommand}"
                        IsEnabled="{Binding SignalStatus, Converter={StaticResource SignalStatusToEnabledConverter}}" />
                <Button IsVisible="False"
                        HeightRequest="38"
                        Margin="0,20,0,0"/>
            </StackLayout>

            <!-- Find Beacon State -->
            <StackLayout IsVisible="{Binding CurrentState, Converter={StaticResource StateToVisibilityConverter}, ConverterParameter={x:Static models:AppState.FindBeacon}}"
                         HorizontalOptions="Center"
                         VerticalOptions="Center">
                <Button Text="Find Beacon"
                        Style="{StaticResource MainActionButton}"
                        Command="{Binding StartNavigationCommand}" />
            </StackLayout>

            <!-- Navigation State -->
            <Grid IsVisible="{Binding CurrentState, Converter={StaticResource StateToVisibilityConverter}, ConverterParameter={x:Static models:AppState.Navigation}}"
                  RowDefinitions="*,Auto">
                <Grid>
                    <!-- Direction arrow -->
                    <Image Source="nav_arrow.png"
                           Rotation="{Binding ArrowRotation}"
                           Scale="1.0"
                           HeightRequest="300"
                           WidthRequest="300"
                           HorizontalOptions="Center"
                           VerticalOptions="Center"
                           Aspect="AspectFit" />
                </Grid>

                <Label Grid.Row="1"
                       Text="{Binding Distance, StringFormat='{0:F0} meters away'}"
                       FontSize="24"
                       HorizontalOptions="Center" />
            </Grid>

            <!-- Destination State -->
            <StackLayout IsVisible="{Binding CurrentState, Converter={StaticResource StateToVisibilityConverter}, ConverterParameter={x:Static models:AppState.Destination}}"
                         HorizontalOptions="Center"
                         VerticalOptions="Center">
                <Label Text="You made it!"
                       FontSize="32"
                       HorizontalOptions="Center" />
                <Button Text="Complete Journey"
                        Command="{Binding CompleteJourneyCommand}"
                        Margin="0,20,0,0"
                        WidthRequest="200"
                        HorizontalOptions="Center" />
            </StackLayout>
        </Grid>

        <!-- Action Button Row -->
        <Grid Grid.Row="2">
            <!-- Clear Beacon Button -->
            <Button Text="Clear Beacon"
                    Command="{Binding ClearBeaconCommand}"
                    IsVisible="{Binding CurrentState, Converter={StaticResource StateToVisibilityConverter}, ConverterParameter={x:Static models:AppState.FindBeacon}}"
                    Margin="0,0,0,10"
                    WidthRequest="200"
                    HorizontalOptions="Center" />

            <!-- Stop Navigation Button -->
            <Button Text="Stop Navigation"
                    Command="{Binding StopNavigationCommand}"
                    IsVisible="{Binding CurrentState, Converter={StaticResource StateToVisibilityConverter}, ConverterParameter={x:Static models:AppState.Navigation}}"
                    Margin="0,0,0,10"
                    WidthRequest="200"
                    HorizontalOptions="Center" />
        </Grid>

        <!-- Status Banner -->
        <Border Grid.Row="3"
                HorizontalOptions="FillAndExpand"
                BackgroundColor="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray600}}"
                Stroke="{AppThemeBinding Light={StaticResource Gray300}, Dark={StaticResource Gray500}}"
                StrokeThickness="1"
                StrokeShape="Rectangle"
                HeightRequest="50"
                Margin="-20,20,-20,0">

            <Grid ColumnDefinitions="Auto,*"
                  Padding="20,12">

                <BoxView Grid.Column="0"
                         WidthRequest="0"
                         IsVisible="False"/>

                <!-- Status Message -->
                <Label Grid.Column="1"
                       Text="{Binding StatusMessage}"
                       FontSize="14"
                       VerticalOptions="Center"
                       HorizontalOptions="Center"
                       TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource Gray100}}" />

                <Ellipse Grid.Column="2"
                         HeightRequest="30"
                         WidthRequest="30"
                         BackgroundColor="Black"
                         Margin="0,0,10,0"
                         HorizontalOptions="End"/>

                <Ellipse Grid.Column="2" 
                         Fill="{Binding SignalStatus, Converter={StaticResource SignalStatusToColorConverter}}"
                         HeightRequest="25"
                         WidthRequest="25"
                         HorizontalOptions="End"
                         VerticalOptions="Center"
                         Margin="0,0,12.5,0"/>
            </Grid>
        </Border>
    </Grid>
</ContentPage>